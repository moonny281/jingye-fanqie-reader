<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：用于内置番茄小说网关直连下载 或 连接局域网 FastAPI 后端 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".JingyeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="净页"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Jingye">

        <activity
            android:name=".ui.shelf.ShelfActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.fanqie.FanqieActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ui.reader.ReaderActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|orientation" />

        <activity
            android:name=".ui.toc.TocActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.debug.EpdDebugActivity"
            android:screenOrientation="portrait" />

    </application>

</manifest>
