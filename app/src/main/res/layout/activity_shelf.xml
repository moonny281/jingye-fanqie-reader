<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 56dp, 下方 2dp 黑线 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="净页"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFanqie"
                style="@style/InkButton"
                android:text="番茄" />

            <Button
                android:id="@+id/btnImport"
                style="@style/InkButton"
                android:text="导入" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/InkButton"
                android:text="设置" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#000000" />

        <!-- 静态提示/错误信息行（不用 Toast 动画） -->
        <TextView
            android:id="@+id/errorLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="#000000"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 书架列表与空状态 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="书架是空的，点【番茄】在线下载或点【导入】添加 TXT"
                android:textColor="#000000"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 长按删除确认面板：瞬时显隐，无系统弹窗动画 -->
    <FrameLayout
        android:id="@+id/deleteDialogOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/ink_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/deleteDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="删除本书？"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deleteDialogSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="将同时删除本地副本与阅读进度"
                android:textColor="#000000"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelDelete"
                    style="@style/InkButton"
                    android:text="取消" />

                <Button
                    android:id="@+id/btnConfirmDelete"
                    style="@style/InkButton"
                    android:text="确认" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
