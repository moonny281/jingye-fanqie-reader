<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseSettings"
            style="@style/InkButton"
            android:text="关闭" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- 1. 字号 14-40sp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字号 (sp)"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnFontMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valFontSize"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnFontPlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 2. 行距 1.2-2.0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="行距"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnSpacingMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valLineSpacing"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnSpacingPlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 3. 页边距 8-48dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="页边距 (dp)"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnMarginMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valMargin"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnMarginPlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 4. 字重 加粗(Medium) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字重加粗 (Medium)"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnToggleBold"
                    style="@style/InkButton"
                    android:minWidth="88dp"
                    android:text="关" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 5. 抗锯齿 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字体抗锯齿"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnToggleAA"
                    style="@style/InkButton"
                    android:minWidth="88dp"
                    android:text="开" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 6. 局部清影间隔：从不 / 10 / 20 / 30 / 50 / 80 页 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="局部清影间隔"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnCleanMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valCleanPages"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnCleanPlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 7. 翻页最小间隔 150-600ms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="翻页最小间隔 (ms)"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnThrottleMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valThrottleMs"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnThrottlePlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 8. 左右点击互换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="左右点击区域互换"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnToggleSwapZones"
                    style="@style/InkButton"
                    android:minWidth="88dp"
                    android:text="关" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 9. 番茄 APP 网关批次间隔 (秒) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="番茄批次间隔 (秒)"
                    android:textColor="#000000"
                    android:textSize="18sp" />
                <Button android:id="@+id/btnIntervalMinus" style="@style/InkButton" android:text="−" />
                <TextView
                    android:id="@+id/valAppInterval"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnIntervalPlus" style="@style/InkButton" android:text="+" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

            <!-- 10. 墨水屏调试入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnOpenEpdDebug"
                    style="@style/InkButton"
                    android:layout_width="match_parent"
                    android:text="海信 A7 墨水屏调试页 (实验 E1–E6)" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
