<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnCloseSettings"
            style="@style/InkButton"
            android:text="← 返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="阅读与墨水屏设置"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ink_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="v0.2.1"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 分组一：阅读排版 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="阅读排版"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ink_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <!-- 1. 字号 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="正文字号 (sp)"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnFontMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valFontSize"
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnFontPlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 2. 行距 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="段落行距"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnSpacingMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valLineSpacing"
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnSpacingPlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 3. 页边距 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="四周页边距 (dp)"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnMarginMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valMargin"
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnMarginPlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 4. 字重加粗 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="墨水屏字体加粗 (Medium)"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/btnToggleBold"
                        style="@style/InkButton"
                        android:minWidth="76dp"
                        android:text="关" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 5. 抗锯齿 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="边缘抗锯齿"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/btnToggleAA"
                        style="@style/InkButton"
                        android:minWidth="76dp"
                        android:text="开" />
                </LinearLayout>
            </LinearLayout>

            <!-- 分组二：墨水屏刷新与翻页操控 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="墨水屏清影与操控"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ink_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <!-- 6. 局部清影间隔 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="文字区局部清影间隔"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnCleanMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valCleanPages"
                        android:layout_width="68dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnCleanPlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 7. 翻页节流 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="翻页防抖最小间隔"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnThrottleMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valThrottleMs"
                        android:layout_width="68dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnThrottlePlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" />

                <!-- 8. 左右点击互换 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="左右点击翻页区域互换"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/btnToggleSwapZones"
                        style="@style/InkButton"
                        android:minWidth="76dp"
                        android:text="关" />
                </LinearLayout>
            </LinearLayout>

            <!-- 分组三：番茄网关与硬件调试 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="下载网关与硬件实验室"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ink_card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="番茄 APP 网关批次间隔"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                    <Button android:id="@+id/btnIntervalMinus" style="@style/InkButton" android:text="−" />
                    <TextView
                        android:id="@+id/valAppInterval"
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <Button android:id="@+id/btnIntervalPlus" style="@style/InkButton" android:text="+" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#000000" />

                <Button
                    android:id="@+id/btnOpenEpdDebug"
                    style="@style/InkButtonSolid"
                    android:layout_width="match_parent"
                    android:text="打开海信 A7 墨水屏硬件调试页 (实验 E1–E6)" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
