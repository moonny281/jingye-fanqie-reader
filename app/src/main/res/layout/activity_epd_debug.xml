<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_eink_button_outline"
            android:textColor="@color/selector_eink_text"
            android:text="← 返回"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEpdTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="墨水屏全刷步长与残影实验室"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnStepMinus"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_eink_button_outline"
            android:textColor="@color/selector_eink_text"
            android:text="-"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="12页"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnStepPlus"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_eink_button_outline"
            android:textColor="@color/selector_eink_text"
            android:text="+"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSwitchPattern"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_eink_button_outline"
            android:textColor="@color/selector_eink_text"
            android:text="切换图案"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnForceFullRefresh"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_eink_button_solid"
            android:textColor="@color/selector_eink_text_solid"
            android:text="全刷"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <io.legado.app.eink.TestPatterns
        android:id="@+id/patternView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
