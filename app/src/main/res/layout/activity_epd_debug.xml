<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Jingye.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="← 返回"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="墨水屏残影测试"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnSwitchPattern"
            style="@style/Widget.Jingye.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="切换图案"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnForceFullRefresh"
            style="@style/Widget.Jingye.Button.Solid"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="强制全刷"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <app.jingye.reader.ui.debug.TestPatterns
        android:id="@+id/patternView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
