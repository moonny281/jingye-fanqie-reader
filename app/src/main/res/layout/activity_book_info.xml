<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <!-- 隐藏装饰性高斯模糊背景图，仅保留真实图书封面 -->
    <ImageView
        android:id="@+id/bg_book"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/bg_image"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/vw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:orientation="vertical">

        <io.legado.app.ui.widget.TitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/book_info" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFFFF">

            <io.legado.app.ui.widget.NoChildScrollNestedScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:background="#FFFFFFFF"
                android:fillViewport="true"
                android:fitsSystemWindows="false"
                android:focusable="true"
                android:overScrollMode="never"
                android:padding="0dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#FFFFFFFF"
                    android:orientation="vertical">

                    <io.legado.app.ui.widget.image.ArcView
                        android:id="@+id/arc_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/ll_info"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFFFF"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- 微信读书墨水屏线性详情头框（保留左侧图书封面 + 右侧线性信息） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_eink_card_thick"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/iv_cover_c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#FFFFFFFF"
                                app:cardCornerRadius="0dp"
                                app:cardElevation="0dp">

                                <io.legado.app.ui.widget.image.CoverImageView
                                    android:id="@+id/iv_cover"
                                    android:layout_width="86dp"
                                    android:layout_height="116dp"
                                    android:background="@drawable/bg_eink_cover_border"
                                    android:contentDescription="@string/img_cover"
                                    android:padding="1dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bg_eink_default_cover_linear" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="@string/book_name"
                                    android:textColor="#FF000000"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:overScrollMode="never"
                                    android:scrollbars="none">

                                    <io.legado.app.ui.widget.LabelsBar
                                        android:id="@+id/lb_kind"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </HorizontalScrollView>

                                <TextView
                                    android:id="@+id/tv_author"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:text="@string/author"
                                    android:textColor="#FF000000"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/iv_web"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        android:contentDescription="@string/origin_format"
                                        android:visibility="gone" />

                                    <TextView
                                        android:id="@+id/tv_origin"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:paddingEnd="6dp"
                                        android:singleLine="true"
                                        android:textColor="#FF000000"
                                        android:textSize="12sp"
                                        tools:ignore="RtlSymmetry"
                                        tools:text="@string/origin_format" />

                                    <io.legado.app.ui.widget.text.AccentBgTextView
                                        android:id="@+id/tv_change_source"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_eink_button_outline"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="2dp"
                                        android:text="@string/change_origin"
                                        android:textColor="#FF000000"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/ic_book_last"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        android:contentDescription="@string/read_dur_progress"
                                        android:visibility="gone" />

                                    <TextView
                                        android:id="@+id/tv_lasted"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:singleLine="true"
                                        android:textColor="#FF000000"
                                        android:textSize="12sp"
                                        tools:text="@string/read_dur_progress" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_group"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:paddingEnd="6dp"
                                        android:singleLine="true"
                                        android:textColor="#FF000000"
                                        android:textSize="12sp"
                                        tools:ignore="RtlSymmetry"
                                        tools:text="@string/group_s" />

                                    <io.legado.app.ui.widget.text.AccentBgTextView
                                        android:id="@+id/tv_change_group"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_eink_button_outline"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="2dp"
                                        android:text="@string/change_group"
                                        android:textColor="#FF000000"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ll_toc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_toc"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:paddingEnd="6dp"
                                        android:singleLine="true"
                                        android:textColor="#FF000000"
                                        android:textSize="12sp"
                                        tools:ignore="RtlSymmetry"
                                        tools:text="@string/toc_s" />

                                    <io.legado.app.ui.widget.text.AccentBgTextView
                                        android:id="@+id/tv_toc_view"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_eink_button_outline"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="2dp"
                                        android:text="@string/view_toc"
                                        android:textColor="#FF000000"
                                        android:textSize="11sp" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- 线性简介框 -->
                        <FrameLayout
                            android:id="@+id/tv_intro_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_eink_card"
                            android:padding="12dp" />

                    </LinearLayout>

                </LinearLayout>

            </io.legado.app.ui.widget.NoChildScrollNestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/fl_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_eink_border_top"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_shelf"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/selector_eink_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/remove_from_bookshelf"
                android:textColor="#FF000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fanqie_info_action"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.1"
                android:background="@drawable/selector_eink_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="目录/导出"
                android:textColor="#FF000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/tv_read"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_button_solid"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/reading"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
