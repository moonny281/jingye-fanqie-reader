<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fanqieRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <!-- 微信读书墨水屏纯黑白线性顶栏（全部按钮显式清除默认内边距，防止文字截断） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_eink_border_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/selector_eink_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="← 书架"
            android:textAllCaps="false"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="番茄书城 · 墨水屏版"
            android:textColor="#FF000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEinkClean"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/selector_eink_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="清残影"
            android:textAllCaps="false"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPasteClipboard"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/selector_eink_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="粘贴链接"
            android:textAllCaps="false"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleConfig"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/selector_eink_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="引擎"
            android:textAllCaps="false"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 隐藏式远端引擎面板 -->
    <LinearLayout
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载引擎模式（默认留空直接使用内置本地引擎，无需部署服务器）"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_card"
                android:hint="留空=手机内置引擎；或填 http://IP:5000"
                android:inputType="textUri"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#FF000000"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveServer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_eink_button_solid"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="保存"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 微信读书墨水屏风格纯黑白线性搜索框 + 分类胶囊排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBookInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_search_box"
                android:hint="输入书名、作者、主角名，或粘贴番茄分享链接"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#FF000000"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearInput"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_eink_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="清空"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchBook"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_eink_button_solid"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="搜索"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="分类："
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat1"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="十日终焉"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="玄幻仙侠"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat3"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="历史古代"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat4"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="悬疑脑洞"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat5"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="科幻末世"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat6"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:text="都市高武"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点击搜索结果可直接立即阅读、全本后台离线或导出含目录 TXT/EPUB"
            android:textColor="#FF000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 书籍详情卡片：双排宽按钮布局，彻底解决多按钮同行挤压截断显示不全问题 -->
    <LinearLayout
        android:id="@+id/bookInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_eink_card_thick"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetailCover"
                android:layout_width="76dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_eink_cover_border"
                android:contentDescription="封面"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_eink_default_cover_linear" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBookTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FF000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnBackToSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/selector_eink_button"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="返回列表"
                        android:textAllCaps="false"
                        android:textColor="#FF000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FF000000"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBookLatestChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookCheckpointInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#FF000000"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_eink_border_top"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="3"
            android:paddingTop="8dp"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF000000"
            android:visibility="gone" />

        <!-- 第一排主操作按钮：立即阅读 + 全本后台离线/断点续下 + 暂停 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenDownloadedBook"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_button_solid"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="立即阅读（秒开）"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDownloadBook"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.15"
                android:background="@drawable/selector_eink_button"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="全本后台离线"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPauseDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_eink_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="暂停"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 第二排辅助功能按钮：目录预览 + 导出 TXT/EPUB + 重新下载（三列等宽对齐，绝不挤压） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPreviewToc"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/selector_eink_button"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="目录预览"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportBook"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/selector_eink_button"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="导出TXT/EPUB"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRedownloadBook"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/selector_eink_button"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="重新下载"
                android:textAllCaps="false"
                android:textColor="#FF000000"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 搜索结果列表头 -->
    <LinearLayout
        android:id="@+id/searchHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSearchResultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="搜索结果"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFFFF"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp" />

</LinearLayout>
