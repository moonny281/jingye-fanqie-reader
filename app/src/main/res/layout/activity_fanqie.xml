<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fanqieRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <!-- 微信读书墨水屏纯黑白线性顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_eink_border_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/selector_eink_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:stateListAnimator="@null"
            android:text="← 书架"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="番茄书城 · 纯净墨水屏版"
            android:textColor="#FF000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEinkClean"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/selector_eink_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="清残影"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPasteClipboard"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/selector_eink_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="粘贴链接"
            android:textColor="#FF000000"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleConfig"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/selector_eink_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="引擎"
            android:textColor="#FF000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 隐藏式远端引擎面板 -->
    <LinearLayout
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载引擎模式（默认留空直接使用内置本地引擎，无需部署服务器）"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_card"
                android:hint="留空=手机内置引擎；或填 http://IP:5000"
                android:inputType="textUri"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#FF000000"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveServer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_eink_button_solid"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null"
                android:text="保存"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 微信读书墨水屏风格纯黑白线性搜索框 + 分类胶囊排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBookInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_eink_search_box"
                android:hint="输入书名、作者、主角名，或粘贴番茄分享链接"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#FF000000"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearInput"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_eink_button"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@null"
                android:text="清空"
                android:textColor="#FF000000"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSearchBook"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_eink_button_solid"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:text="搜索"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="分类："
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat1"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="十日终焉"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat2"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="玄幻仙侠"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat3"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="历史古代"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat4"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="悬疑脑洞"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat5"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="科幻末世"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCat6"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_eink_button_outline"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="都市高武"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="纯黑白线性无图模式：点击搜索结果可立即阅读、全本后台离线或导出含目录 TXT/EPUB"
            android:textColor="#FF000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 书籍详情与流式阅读/后台断点下载/原生目录导出纯黑白线性卡片（移除封面图片） -->
    <LinearLayout
        android:id="@+id/bookInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_eink_card_thick"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivDetailCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="封面"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBackToSearch"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/selector_eink_button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@null"
                android:text="返回列表"
                android:textColor="#FF000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBookLatestChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBookCheckpointInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvBookIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_eink_border_top"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="4"
            android:paddingTop="8dp"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF000000"
            android:visibility="gone" />

        <!-- 原生无缝操作栏：立即阅读（秒开） + 全本后台离线 + 导出小说 + 暂停 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenDownloadedBook"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_eink_button_solid"
                android:stateListAnimator="@null"
                android:text="立即阅读（秒开）"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDownloadBook"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/selector_eink_button"
                android:stateListAnimator="@null"
                android:text="全本后台离线"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportBook"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_eink_button"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null"
                android:text="导出小说"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPauseDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_eink_button"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@null"
                android:text="暂停"
                android:textColor="#FF000000"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 搜索结果列表头 -->
    <LinearLayout
        android:id="@+id/searchHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eink_border_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSearchResultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="搜索结果"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFFFF"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp" />

</LinearLayout>
