<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 纯白底 + 外层 1.2dp 纯黑线性边框 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1.2dp" android:color="#FF000000" />
        </shape>
    </item>
    <!-- 内部线性装帧内框，用作无图或加载中时的纯黑白线性默认书封 -->
    <item
        android:bottom="5dp"
        android:left="8dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="0.8dp" android:color="#FF000000" />
        </shape>
    </item>
</layer-list>
