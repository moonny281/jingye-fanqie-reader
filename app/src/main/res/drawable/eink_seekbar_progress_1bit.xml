<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#FF000000" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical" android:height="4dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FF000000" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="4dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FF000000" />
            </shape>
        </clip>
    </item>
</layer-list>
