<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Jingye" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="colorControlHighlight">#00000000</item>
    </style>

    <style name="Widget.Jingye.Button.Outline" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_eink_button_outline</item>
        <item name="android:textColor">@color/selector_eink_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Jingye.Button.Solid" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_eink_button_solid</item>
        <item name="android:textColor">@color/selector_eink_text_solid</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="InkButton" parent="Widget.Jingye.Button.Outline" />
    <style name="InkButtonSolid" parent="Widget.Jingye.Button.Solid" />
</resources>
